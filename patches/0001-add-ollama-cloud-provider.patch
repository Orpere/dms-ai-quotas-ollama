+                    ol_inner=$(printf '%s' "$ol_meter" | sed -E 's/^aria-label="Monthly usage[[:space:]]+//; s/[[:space:]]+used"$//')
+                    ol_used_raw=$(printf '%s' "$ol_inner" | sed -E 's/^[[:space:]]*\$//; s/[[:space:]]+of[[:space:]].*//' | tr -d ',')
