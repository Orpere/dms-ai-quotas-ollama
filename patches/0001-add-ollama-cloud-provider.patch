+  <script>
+    function applyLocalTimeTitles() {
+      document.querySelectorAll(".local-time").forEach(function (el) {
+        var iso = el.dataset.time;
+        if (iso) {
+          var d = new Date(iso);
+          el.title = d.toLocaleString(undefined, {
+            weekday: "short",
+            month: "short",
+            day: "numeric",
+            hour: "numeric",
+            minute: "2-digit",
+          });
+        }
+      });
+    }
+    applyLocalTimeTitles();
+    
+    
+    document.body.addEventListener("htmx:afterSwap", applyLocalTimeTitles);
+
+    document.querySelectorAll("[data-usage-meter]").forEach(function (meter) {
+      var bubble = meter.querySelector("[data-usage-bubble]");
+      var model = meter.querySelector("[data-usage-model]");
+      var requests = meter.querySelector("[data-usage-requests]");
+      var segments = meter.querySelectorAll("[data-usage-segment]");
+
+      if (!bubble || !model || !requests || segments.length === 0) {
+        return;
+      }
+
+      function requestLabel(count) {
+        return count === "1" ? "1 request" : count + " requests";
+      }
+
+      function placeBubble(segment) {
+        var meterRect = meter.getBoundingClientRect();
+        var segmentRect = segment.getBoundingClientRect();
+        var bubbleRect = bubble.getBoundingClientRect();
+        var center = segmentRect.left + segmentRect.width / 2 - meterRect.left;
+        var padding = 8;
+        var minX = bubbleRect.width / 2 + padding;
+        var maxX = meterRect.width - bubbleRect.width / 2 - padding;
+        var x =
+          maxX < minX
+            ? meterRect.width / 2
+            : Math.max(minX, Math.min(center, maxX));
+
+        meter.style.setProperty("--usage-bubble-x", x + "px");
+      }
+
+      function showSegment(segment) {
+        var count = segment.dataset.requests || "0";
+
+        model.textContent = segment.dataset.model || "";
+        requests.textContent = requestLabel(count);
+        segments.forEach(function (item) {
+          item.classList.remove("is-active");
+        });
+        segment.classList.add("is-active");
+        meter.classList.add("usage-meter--active");
+        requestAnimationFrame(function () {
+          placeBubble(segment);
+        });
+      }
+
+      function hideSegment() {
+        meter.classList.remove("usage-meter--active");
+        segments.forEach(function (item) {
+          item.classList.remove("is-active");
+        });
+      }
+
+      segments.forEach(function (segment) {
+        segment.addEventListener("pointerenter", function () {
+          showSegment(segment);
+        });
+        segment.addEventListener("pointermove", function () {
+          placeBubble(segment);
+        });
+        segment.addEventListener("focus", function () {
+          showSegment(segment);
+        });
+        segment.addEventListener("blur", hideSegment);
+      });
+
+      meter.addEventListener("pointerleave", hideSegment);
+    });
+  </script>
