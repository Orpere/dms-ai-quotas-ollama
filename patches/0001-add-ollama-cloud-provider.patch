+        esac
+        ol_cookie="${ol_cookie%%;*}"
+        ol_cookie=$(printf '%s' "$ol_cookie" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
+    fi
+    [ -n "$ol_cookie" ] && ol_cookie_attempted=1
+
+    ol_is_num() {
+        case "$1" in
+            ''|*[!0-9.]*) return 1 ;;
